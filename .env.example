# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/student_analytics_db

# JWT Secret & Expiry
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
JWT_EXPIRE=7d

# CORS Allowed Origins (Comma-separated for multiple origins, e.g., Vite dev server)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Academic Grading Defaults (Configurable until official college grading rules are defined)
GRADING_MAX_QUIZ=20
GRADING_MAX_SURPRISE_TEST=10
GRADING_MAX_MID_TERM=30
GRADING_MAX_END_TERM=40
GRADING_TOTAL_MARKS=100
WEAK_SUBJECT_PERCENTAGE_THRESHOLD=55
WEAK_SUBJECT_DEVIATION_THRESHOLD=10
