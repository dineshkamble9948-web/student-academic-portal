    {
      "name": "3. Senior Mentorship",
      "item": [
        {
          "name": "Get Available Mentors (All)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mentors",
              "host": ["{{baseUrl}}"],
              "path": ["mentors"]
            }
          }
        },
        {
          "name": "Filter Mentors (Female Only Preference)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mentors?femaleOnly=true",
              "host": ["{{baseUrl}}"],
              "path": ["mentors"],
              "query": [{ "key": "femaleOnly", "value": "true" }]
            }
          }
        },
        {
          "name": "Filter Mentors by Subject Code",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mentors?subjectCode=CS501",
              "host": ["{{baseUrl}}"],
              "path": ["mentors"],
              "query": [{ "key": "subjectCode", "value": "CS501" }]
            }
          }
        },
        {
          "name": "Send Mentorship Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seniorId\": \"REPLACE_WITH_SENIOR_USER_ID\",\n  \"topic\": \"Concurrency Control and Two-Phase Locking (2PL)\",\n  \"message\": \"I am struggling with conflict serializability and need advice for end-term exams.\",\n  \"femaleMentorOnly\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mentorship/request",
              "host": ["{{baseUrl}}"],
              "path": ["mentorship", "request"]
            }
          }
        },
        {
          "name": "Get My Mentorship Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/mentorship/my-requests",
              "host": ["{{baseUrl}}"],
              "path": ["mentorship", "my-requests"]
            }
          }
        },
        {
          "name": "Senior: Respond to Mentorship Request (Accept)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accepted\",\n  \"responseNote\": \"Session confirmed! Let us meet tomorrow at 6 PM.\",\n  \"meetingLink\": \"https://meet.google.com/xyz-uvw-rst\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mentorship/requests/REPLACE_WITH_REQUEST_ID/respond",
              "host": ["{{baseUrl}}"],
              "path": ["mentorship", "requests", "REPLACE_WITH_REQUEST_ID", "respond"]
            }
          }
        }
      ]
    },
