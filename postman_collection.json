            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deepak Joshi\",\n  \"rollNumber\": \"21CS099\",\n  \"email\": \"deepak.joshi@college.edu\",\n  \"password\": \"password123\",\n  \"role\": \"Student\",\n  \"gender\": \"Male\",\n  \"branch\": \"CSE\",\n  \"year\": 3,\n  \"currentSemester\": 5,\n  \"phone\": \"+91 9123456780\",\n  \"studyPreferences\": {\n    \"dailyTargetHours\": 4,\n    \"preferredStudyTimes\": [\"evening\", \"night\"]\n  }\n}"
